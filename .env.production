# QAMill Production Environment Configuration
# CHANGE ALL VALUES BEFORE DEPLOYING

# ── API Configuration ──
API_HOST=0.0.0.0
API_PORT=8765
API_DEBUG=false
API_RELOAD=false
API_WORKERS=4
ENVIRONMENT=production

# ── Database Configuration ──
# PostgreSQL (production)
DATABASE_URL=postgresql://qamill_user:CHANGE_PASSWORD@db.example.com:5432/qamill_prod
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Authentication ──
AUTH_JWT_SECRET=CHANGE_TO_RANDOM_SECRET_KEY_32_CHARS_MIN
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth Providers ──
OAUTH_GITHUB_CLIENT_ID=GITHUB_OAUTH_CLIENT_ID
OAUTH_GITHUB_CLIENT_SECRET=GITHUB_OAUTH_CLIENT_SECRET
OAUTH_GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback

OAUTH_GOOGLE_CLIENT_ID=GOOGLE_OAUTH_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET
OAUTH_GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ── LLM Providers ──
LLM_DEFAULT_PROVIDER=claude
LLM_CLAUDE_API_KEY=ANTHROPIC_API_KEY
LLM_GPT_API_KEY=OPENAI_API_KEY
LLM_GEMINI_API_KEY=GOOGLE_GEMINI_API_KEY
LLM_GROK_API_KEY=XCOM_GROK_API_KEY

# ── Storage Configuration ──
STORAGE_TYPE=s3
STORAGE_S3_BUCKET=qamill-prod
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=AWS_ACCESS_KEY
STORAGE_S3_SECRET_KEY=AWS_SECRET_KEY

# ── Redis Configuration ──
REDIS_URL=redis://redis.internal:6379

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=/var/log/qamill/api.log

# ── Security ──
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Monitoring ──
SENTRY_DSN=https://YOUR_SENTRY_KEY@sentry.io/project-id
DATADOG_API_KEY=DATADOG_API_KEY
