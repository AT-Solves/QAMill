# QAMill Production Environment Configuration

# Server Configuration
QAMILL_HOST=0.0.0.0
QAMILL_PORT=8765
ENVIRONMENT=production
DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=backend/logs/qamill.log

# Database Configuration
DATABASE_URL=sqlite:///./qamill_prod.db
DATABASE_ECHO=false

# LLM Configuration
DEFAULT_LLM_PROVIDER=claude
OLLAMA_MODEL=llama2

# API Keys (should be set via environment variables in production)
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Timeout Configuration (seconds)
TIMEOUT_STREAM_EVENT=10
TIMEOUT_SMTP=15
TIMEOUT_SOCKET=30

# CORS Configuration
CORS_ORIGINS=https://qamill.achieverthoughts.com,https://marketplace.visualstudio.com

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD should be set via environment variables

# Monitoring Configuration
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=60
MAX_ERROR_COUNT=500
MAX_MEMORY_PERCENT=90

# Recovery Configuration
ENABLE_AUTO_RECOVERY=true
RECOVERY_RESTART_DELAY=30
