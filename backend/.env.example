# QAMill Configuration
# Copy to .env and adjust values for your environment

# ── API Configuration ──
API_HOST=0.0.0.0
API_PORT=8765
API_DEBUG=false
API_RELOAD=false
API_WORKERS=1

# ── Database Configuration ──
# SQLite (development)
DATABASE_URL=sqlite:///./qamill.db

# PostgreSQL (production - uncomment and adjust)
# DATABASE_URL=postgresql://user:password@localhost:5432/qamill

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Authentication ──
AUTH_JWT_SECRET=your-secret-key-change-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Providers ──
LLM_DEFAULT_PROVIDER=ollama

# Claude API
LLM_CLAUDE_API_KEY=

# GPT API
LLM_GPT_API_KEY=

# Gemini API
LLM_GEMINI_API_KEY=

# Grok API
LLM_GROK_API_KEY=

# ── Storage Configuration ──
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1

# ── Environment ──
APP_NAME=QAMill AI QA Governance
APP_VERSION=1.2.0
ENVIRONMENT=development
