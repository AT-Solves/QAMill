{
  "name": "qamill-mutation-testing",
  "displayName": "QAMill — AI Mutation Testing",
  "description": "QAMill: equivalent mutant detection, auto-healing tests, live dashboard.",
  "version": "1.0.0",
  "publisher": "amil",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing", "Other"],
"main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "amil.runAnalysis",
        "title": "QAMill: Run Mutation Analysis"
      },
      {
        "command": "amil.stopAnalysis",
        "title": "QAMill: Stop Analysis"
      },
      {
        "command": "amil.selectLLM",
        "title": "QAMill: Select LLM Provider"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "amil.runAnalysis",
          "group": "testing",
          "when": "resourceExtname == .py"
        }
      ],
      "explorer/context": [
        {
          "command": "amil.runAnalysis",
          "group": "testing",
          "when": "resourceExtname == .py || explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "QAMill Mutation Testing",
      "properties": {
        "amil.llmProvider": {
          "type": "string",
          "default": "inhouse",
          "enum": ["none", "claude", "gpt", "grok", "inhouse"],
          "enumDescriptions": [
            "In-house AST only — no API calls",
            "Anthropic Claude",
            "OpenAI GPT-4o",
            "xAI Grok",
            "Local Ollama (fully offline)"
          ],
          "description": "LLM provider for equivalent detection and test healing"
        },
        "amil.anthropicApiKey": { "type": "string", "default": "", "description": "Anthropic API key" },
        "amil.openaiApiKey":    { "type": "string", "default": "", "description": "OpenAI API key" },
        "amil.xaiApiKey":       { "type": "string", "default": "", "description": "xAI API key" },
        "amil.ollamaModel":     { "type": "string", "default": "llama3", "description": "Ollama model name" },
        "amil.autoHeal":        { "type": "boolean", "default": true, "description": "Auto-generate tests for survived mutants" },
        "amil.detectEquivalents": { "type": "boolean", "default": true, "description": "Filter equivalent mutants" },
        "amil.backendPort":     { "type": "number", "default": 8765, "description": "QAMill backend port" }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
