{
  "name": "qamill-mutation-testing",
  "displayName": "QAMill — AI Mutation Testing",
  "description": "Enterprise-grade mutation testing for Python and JavaScript. Real-time analysis, elite reports, and team collaboration.",
  "version": "1.2.1",
  "publisher": "achieverthoughts",
  "repository": {
    "type": "git",
    "url": "https://github.com/AT-Solves/QAMill"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "icon": "media/qamill-logo.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onCommand:amil.runAnalysis",
    "onCommand:amil.openTestStudio",
    "onCommand:amil.selectLLM"
  ],
  "contributes": {
    "commands": [
      {
        "command": "amil.runAnalysis",
        "title": "QAMill: Analyze Test Quality"
      },
      {
        "command": "amil.stopAnalysis",
        "title": "QAMill: Stop Analysis"
      },
      {
        "command": "amil.selectLLM",
        "title": "QAMill: Select AI Model"
      },
      {
        "command": "amil.generateUnitTests",
        "title": "QAMill: Generate Unit Tests"
      },
      {
        "command": "amil.generateManualTests",
        "title": "QAMill: Generate QA Test Cases"
      },
      {
        "command": "amil.openTestStudio",
        "title": "QAMill: Open Test Authoring Studio"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "qamill.main",
          "group": "testing",
          "when": "resourceExtname == .py || resourceExtname == .ts || resourceExtname == .js || resourceExtname == .tsx || resourceExtname == .jsx"
        }
      ],
      "explorer/context": [
        {
          "submenu": "qamill.main",
          "group": "testing",
          "when": "resourceExtname == .py || resourceExtname == .ts || resourceExtname == .js || resourceExtname == .tsx || resourceExtname == .jsx || explorerResourceIsFolder"
        }
      ],
      "qamill.main": [
        {
          "command": "amil.runAnalysis",
          "title": "Test Quality Check",
          "group": "1_qamill"
        },
        {
          "command": "amil.generateUnitTests",
          "title": "Unit Tests",
          "group": "1_qamill"
        },
        {
          "command": "amil.generateManualTests",
          "title": "QA Tests",
          "group": "1_qamill"
        }
      ]
    },
    "submenus": [
      {
        "id": "qamill.main",
        "label": "QAMill"
      }
    ],
    "configuration": {
      "title": "QAMill QA Governance",
      "properties": {
        "amil.llmProvider": {
          "type": "string",
          "default": "inhouse",
          "enum": [
            "none",
            "claude",
            "gpt",
            "grok",
            "inhouse"
          ],
          "enumDescriptions": [
            "In-house AST only — no API calls",
            "Anthropic Claude",
            "OpenAI GPT-4o",
            "xAI Grok",
            "Local Ollama (fully offline)"
          ],
          "description": "LLM provider for equivalent detection and test healing"
        },
        "amil.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key"
        },
        "amil.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key"
        },
        "amil.xaiApiKey": {
          "type": "string",
          "default": "",
          "description": "xAI API key"
        },
        "amil.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key"
        },
        "amil.openrouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key"
        },
        "amil.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key"
        },
        "amil.mistralApiKey": {
          "type": "string",
          "default": "",
          "description": "Mistral API key"
        },
        "amil.ollamaModel": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model name"
        },
        "amil.autoHeal": {
          "type": "boolean",
          "default": true,
          "description": "Auto-generate tests for survived mutants"
        },
        "amil.detectEquivalents": {
          "type": "boolean",
          "default": true,
          "description": "Filter equivalent mutants"
        },
        "amil.backendPort": {
          "type": "number",
          "default": 8765,
          "description": "QAMill backend port"
        },
        "amil.userEmail": {
          "type": "string",
          "default": "",
          "description": "Signed-in QAMill account email"
        },
        "amil.emailType": {
          "type": "string",
          "default": "work",
          "enum": [
            "work",
            "personal"
          ],
          "description": "Account type for the sender identity"
        },
        "amil.email.provider": {
          "type": "string",
          "default": "gmail",
          "enum": [
            "gmail",
            "outlook",
            "custom"
          ],
          "enumDescriptions": [
            "Gmail — smtp.gmail.com:587 (App Password required)",
            "Outlook / Office 365 — smtp-mail.outlook.com:587",
            "Custom SMTP server — enter host and port manually"
          ],
          "description": "SMTP provider for sending QAMill email reports"
        },
        "amil.email.sender": {
          "type": "string",
          "default": "",
          "description": "Your email address (used as sender / SMTP login)"
        },
        "amil.email.appPassword": {
          "type": "string",
          "default": "",
          "description": "App Password for Gmail/Outlook — NOT your regular password"
        },
        "amil.email.recipient": {
          "type": "string",
          "default": "",
          "description": "Recipient email address for QAMill reports"
        },
        "amil.email.to": {
          "type": "string",
          "default": "",
          "description": "(Legacy) Recipient email — use amil.email.recipient instead"
        },
        "amil.email.autoSend": {
          "type": "boolean",
          "default": false,
          "description": "Automatically email report when analysis completes"
        },
        "amil.email.smtpHost": {
          "type": "string",
          "default": "",
          "description": "Custom SMTP server hostname (only used when provider is 'custom')"
        },
        "amil.email.smtpPort": {
          "type": "number",
          "default": 587,
          "description": "Custom SMTP port — 587 for STARTTLS, 465 for SSL"
        },
        "amil.email.smtpUser": {
          "type": "string",
          "default": "",
          "description": "(Legacy) SMTP username — use amil.email.sender instead"
        },
        "amil.email.smtpPassword": {
          "type": "string",
          "default": "",
          "description": "(Legacy) SMTP password — use amil.email.appPassword instead"
        },
        "amil.email.smtpTls": {
          "type": "boolean",
          "default": true,
          "description": "Use STARTTLS (true, port 587) or SSL (false, port 465)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
